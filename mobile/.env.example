# Appwrite Configuration (Auth, Database, Storage)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# AI API Service Configuration (Hosted on Vercel)
# Production: Your deployed Vercel domain (e.g. https://quranic-web.vercel.app)
# Local development: http://localhost:3000 (or your computer's local LAN IP: http://192.168.x.x:3000)
EXPO_PUBLIC_API_URL=https://your-frontend.vercel.app
