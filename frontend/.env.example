# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model Selection:
# Default for official DeepSeek API: "deepseek-chat" (DeepSeek-V3.2 non-thinking mode)
# Thinking model: "deepseek-reasoner" (DeepSeek-R1)
# If using a proxy / provider with custom model name (e.g. v4-flash), specify it here:
DEEPSEEK_MODEL=deepseek-v4-flash

# API Base URL (defaults to official DeepSeek API endpoint):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
